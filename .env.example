# Optional: copy to .env to override defaults.
# Local `docker compose up` works without a .env (the defaults below are applied).

# Host ports
UI_PORT=4173
API_PORT=5000
POSTGRES_PORT=5437
PAPERCUT_UI_PORT=8080
PAPERCUT_SMTP_PORT=25
SEQ_UI_PORT=8081
SEQ_INGEST_PORT=5341
JAEGER_UI_PORT=16686

# Database
POSTGRES_DB=calconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT (must be at least 32 characters)
JWT_SECRET=local-development-secret-change-me-before-deploying-1234567890
JWT_ISSUER=calconnect
JWT_AUDIENCE=account
JWT_EXPIRATION_MINUTES=60
