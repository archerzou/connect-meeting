server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Container liveness probe (used by the Docker HEALTHCHECK).
    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # Reverse-proxy API calls to the backend. The SPA calls "/api/..." and the
    # trailing slash on proxy_pass strips the "/api" prefix, so the backend sees
    # "/users/...", "/meetings/...", etc.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Long-cache hashed assets.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback so client-side routes (e.g. /meetings/:id) resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
